#include <stdio.h>
#include <math.h>
#define PI 3.14

int main(void)
{
    double radius, area, circum;

    printf("Enter radius of the circle:");
    scanf("%lf", &radius);

    area = PI * pow(radius, 2);
    circum = 2 * PI * radius;

    printf("Area=%8.2f and Circumference=%8.2f for radius %5.2f\n", area, circum, radius);

    return 0;
}
