#include <stdio.h>
#define BEGIN 10
#define END -5
#define STEP 5

int main(void)
{
	double celsius, fahrenheit;
	
		printf("  Celsius     Fahrenheit \n");
		printf("============  ===========\n");
	for(celsius=BEGIN;celsius>=END;celsius-=STEP)
	{
		fahrenheit=1.8*celsius+32;
		printf("%8.3lf\t%8.3lf\n",celsius,fahrenheit);
	}
	return 0;
}
